generator client {
  provider = "prisma-client-js"
  output   = "../backend/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Position {
  GK
  DEF
  MID
  FWD
  FLEX
}

enum MatchStatus {
  OPEN
  FULL
  LIVE
  COMPLETED
  CANCELLED
}

enum MatchVisibility {
  PUBLIC
  PRIVATE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum WalletTransactionType {
  CREDIT
  DEBIT
}

enum NotificationType {
  MATCH
  BOOKING
  WALLET
  SYSTEM
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  profile      PlayerProfile?
  matchesOwned Match[]       @relation("MatchOwner")
  players      MatchPlayer[]
  bookings     Booking[]
  messages     MatchMessage[]
  wallet       WalletTransaction[]
  notifications Notification[]
}

model PlayerProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  name              String
  age               Int
  city              String
  preferredPosition Position @default(FLEX)
  skillLevel        Int
  avatarUrl         String?
  isAvailable       Boolean  @default(false)
  lastSeenAt        DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([city, isAvailable])
}

model Terrain {
  id             String          @id @default(cuid())
  name           String
  city           String
  address        String
  imageUrl       String?
  pricePerHour   Decimal         @db.Decimal(10, 2)
  rating         Float           @default(4.7)
  amenities      String[]        @default([])
  availableHours TerrainSlot[]
  matches        Match[]
  bookings       Booking[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([city])
}

model TerrainSlot {
  id        String   @id @default(cuid())
  terrainId String
  startsAt  DateTime
  endsAt    DateTime
  isBooked  Boolean  @default(false)
  terrain   Terrain  @relation(fields: [terrainId], references: [id], onDelete: Cascade)

  @@index([terrainId, startsAt])
}

model Match {
  id          String          @id @default(cuid())
  title       String
  city        String
  startsAt    DateTime
  maxPlayers  Int             @default(10)
  status      MatchStatus     @default(OPEN)
  visibility  MatchVisibility @default(PUBLIC)
  ownerId     String
  terrainId   String?
  inviteCode  String?         @unique
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  owner       User            @relation("MatchOwner", fields: [ownerId], references: [id])
  terrain     Terrain?        @relation(fields: [terrainId], references: [id])
  players     MatchPlayer[]
  messages    MatchMessage[]
  booking     Booking?

  @@index([city, status, startsAt])
}

model MatchPlayer {
  id       String   @id @default(cuid())
  matchId  String
  userId   String
  team     String?
  joinedAt DateTime @default(now())
  match    Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
}

model MatchMessage {
  id        String   @id @default(cuid())
  matchId   String
  userId    String
  body      String
  createdAt DateTime @default(now())
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([matchId, createdAt])
}

model Booking {
  id        String        @id @default(cuid())
  terrainId String
  userId    String
  matchId   String?       @unique
  startsAt  DateTime
  endsAt    DateTime
  status    BookingStatus @default(CONFIRMED)
  createdAt DateTime      @default(now())
  terrain   Terrain       @relation(fields: [terrainId], references: [id])
  user      User          @relation(fields: [userId], references: [id])
  match     Match?        @relation(fields: [matchId], references: [id])

  @@index([terrainId, startsAt])
}

model WalletTransaction {
  id        String                @id @default(cuid())
  userId    String
  type      WalletTransactionType
  label     String
  amount    Decimal               @db.Decimal(10, 2)
  status    String                @default("CONFIRMED")
  createdAt DateTime              @default(now())
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType @default(SYSTEM)
  title     String
  body      String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
}
