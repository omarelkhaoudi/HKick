generator client {
  provider = "prisma-client-js"
  output   = "../backend/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Position {
  GK
  DEF
  MID
  FWD
  FLEX
}

enum MatchStatus {
  OPEN
  FULL
  LIVE
  COMPLETED
  CANCELLED
}

enum MatchVisibility {
  PUBLIC
  PRIVATE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum WalletTransactionType {
  CREDIT
  DEBIT
}

enum NotificationType {
  MATCH
  BOOKING
  WALLET
  SYSTEM
}

enum AttendanceStatus {
  PENDING
  CONFIRMED
  DECLINED
  CHECKED_IN
  NO_SHOW
}

enum MatchDepositStatus {
  PENDING
  RESERVED
  CAPTURED
  REFUNDED
  FORFEITED
}

enum PaymentProvider {
  INTERNAL
  PAYZONE
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  passwordHash       String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  profile            PlayerProfile?
  matchesOwned       Match[]             @relation("MatchOwner")
  players            MatchPlayer[]
  bookings           Booking[]
  messages           MatchMessage[]
  wallet             WalletTransaction[]
  notifications      Notification[]
  matchConfirmations MatchConfirmation[]
  matchDeposits      MatchDeposit[]
  resultsSubmitted   MatchResult[]       @relation("ResultSubmittedBy")
  reviewsGiven       MatchReview[]       @relation("ReviewAuthor")
  reviewsReceived    MatchReview[]       @relation("ReviewSubject")
}

model PlayerProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  name              String
  age               Int
  city              String
  preferredPosition Position @default(FLEX)
  skillLevel        Int
  avatarUrl         String?
  isAvailable       Boolean  @default(false)
  lastSeenAt        DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([city, isAvailable])
}

model Terrain {
  id             String        @id @default(cuid())
  name           String
  city           String
  address        String
  imageUrl       String?
  pricePerHour   Decimal       @db.Decimal(10, 2)
  rating         Float         @default(4.7)
  amenities      String[]      @default([])
  availableHours TerrainSlot[]
  matches        Match[]
  bookings       Booking[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([city])
}

model TerrainSlot {
  id        String   @id @default(cuid())
  terrainId String
  startsAt  DateTime
  endsAt    DateTime
  isBooked  Boolean  @default(false)
  terrain   Terrain  @relation(fields: [terrainId], references: [id], onDelete: Cascade)

  @@index([terrainId, startsAt])
}

model Match {
  id            String              @id @default(cuid())
  title         String
  city          String
  startsAt      DateTime
  maxPlayers    Int                 @default(10)
  status        MatchStatus         @default(OPEN)
  visibility    MatchVisibility     @default(PUBLIC)
  ownerId       String
  terrainId     String?
  inviteCode    String?             @unique
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  owner         User                @relation("MatchOwner", fields: [ownerId], references: [id])
  terrain       Terrain?            @relation(fields: [terrainId], references: [id])
  players       MatchPlayer[]
  messages      MatchMessage[]
  booking       Booking?
  confirmations MatchConfirmation[]
  deposits      MatchDeposit[]
  result        MatchResult?
  reviews       MatchReview[]

  @@index([city, status, startsAt])
}

model MatchPlayer {
  id       String   @id @default(cuid())
  matchId  String
  userId   String
  team     String?
  joinedAt DateTime @default(now())
  match    Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
}

model MatchMessage {
  id        String   @id @default(cuid())
  matchId   String
  userId    String
  body      String
  createdAt DateTime @default(now())
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([matchId, createdAt])
}

model MatchConfirmation {
  id          String           @id @default(cuid())
  matchId     String
  userId      String
  status      AttendanceStatus @default(PENDING)
  note        String?
  confirmedAt DateTime?
  checkedInAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  match       Match            @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
  @@index([matchId, status])
  @@index([userId, status])
}

model MatchDeposit {
  id                  String             @id @default(cuid())
  matchId             String
  userId              String
  walletTransactionId String?            @unique
  provider            PaymentProvider    @default(INTERNAL)
  providerPaymentId   String?
  providerToken       String?
  checkoutUrl         String?
  amount              Decimal            @db.Decimal(10, 2)
  status              MatchDepositStatus @default(PENDING)
  dueAt               DateTime?
  reservedAt          DateTime?
  paidAt              DateTime?
  capturedAt          DateTime?
  refundedAt          DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  match               Match              @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletTransaction   WalletTransaction? @relation(fields: [walletTransactionId], references: [id], onDelete: SetNull)

  @@unique([matchId, userId])
  @@index([provider, providerPaymentId])
  @@index([providerToken])
  @@index([matchId, status])
  @@index([userId, status])
}

model MatchResult {
  id             String   @id @default(cuid())
  matchId        String   @unique
  submittedById  String
  teamVoltScore  Int
  teamPulseScore Int
  isFinal        Boolean  @default(false)
  submittedAt    DateTime @default(now())
  updatedAt      DateTime @updatedAt
  match          Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  submittedBy    User     @relation("ResultSubmittedBy", fields: [submittedById], references: [id])

  @@index([submittedById, submittedAt])
}

model MatchReview {
  id        String   @id @default(cuid())
  matchId   String
  authorId  String
  subjectId String
  rating    Int
  comment   String?
  tags      String[] @default([])
  createdAt DateTime @default(now())
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  author    User     @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  subject   User     @relation("ReviewSubject", fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([matchId, authorId, subjectId])
  @@index([subjectId, createdAt])
  @@index([matchId, rating])
}

model Booking {
  id        String        @id @default(cuid())
  terrainId String
  userId    String
  matchId   String?       @unique
  startsAt  DateTime
  endsAt    DateTime
  status    BookingStatus @default(CONFIRMED)
  createdAt DateTime      @default(now())
  terrain   Terrain       @relation(fields: [terrainId], references: [id])
  user      User          @relation(fields: [userId], references: [id])
  match     Match?        @relation(fields: [matchId], references: [id])

  @@index([terrainId, startsAt])
}

model WalletTransaction {
  id           String                @id @default(cuid())
  userId       String
  type         WalletTransactionType
  label        String
  amount       Decimal               @db.Decimal(10, 2)
  status       String                @default("CONFIRMED")
  createdAt    DateTime              @default(now())
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  matchDeposit MatchDeposit?

  @@index([userId, createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType @default(SYSTEM)
  title     String
  body      String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
}
